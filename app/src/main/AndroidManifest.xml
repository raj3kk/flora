<?xml version="1.0" encoding="utf-8"?>
<!-- Flora v1.0 manifest — behaviour-based, no creator manifest copy.
     CALL_PHONE / SEND_SMS sirf confirmed automation ke liye hain:
     ek baar bolo + ek confirmation, phir poora execution. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 2 Item 3: in-app update ka sideload install — sirf
         user ke tap par system prompt se; Flora sideload-only hai,
         Play Store par kabhi nahi. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- NoAccess functions (Batch A/C) — NORMAL permissions, install-time
         grant, koi runtime prompt nahi: volume set, network/Wi-Fi state read. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Call announce v1.2: Android 9+ par incoming number ke liye
         READ_PHONE_STATE ke saath READ_CALL_LOG bhi chahiye — iske
         bina EXTRA_INCOMING_NUMBER null milta hai aur announce
         chupchaap nahi hota. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Batch 4: full-screen intent (lock screen par call UI). Android
         14+ par user grant deta hai (canUseFullScreenIntent); 14 se
         neeche declare karna hi kaafi hai. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lane A — A1 One-Tap Fix: adb/Shizuku se grant hone wali
         development permission. Declare kiye bina `pm grant` kaam
         nahi karta. App is permission ko khud kabhi maangta nahi —
         sirf OneTapFix path (user ke tap par) iska use karta hai. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Shizuku (v2.22, G19): Android 11+ package visibility ke liye. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application
        android:name="com.flora.app.FloraApplication"
        android:label="Flora"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material">
        <!-- B5-09 App Startup: FloraToolsInitializer auto-discover
             hoga (startup-runtime ka provider manifest merger se
             aata hai) — Timber plant + tools-init ka single point. -->
        <meta-data
            android:name="com.flora.app.planner.FloraToolsInitializer"
            android:value="androidx.startup" />
        <activity
            android:name="com.flora.app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Assist activity (v2.23, Phase 5): default-assistant trio ka
             teesra hissa — assist trigger par Flora kholo, khud khatam. -->
        <activity
            android:name=".voice.FloraAssistActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name="com.flora.app.automation.FloraAutomationService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name="com.flora.app.calls.FloraInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <activity
            android:name=".calls.CallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <!-- Batch 4: Maya-parity self-activation UI — announce ka UI,
             call control ka nahi (answer/reject isme nahi). -->
        <activity
            android:name=".calls.IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <service
            android:name="com.flora.app.wakeword.WakeWordService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        <service
            android:name="com.flora.app.voice.BackgroundMicService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        <service
            android:name="com.flora.app.push.FloraMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.flora.app.automation.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.flora.app.automation.JobAlarmReceiver"
            android:exported="false" />
        <service
            android:name="com.flora.app.automation.FloraNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.flora.app.automation.CallAnnouncementReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.flora.app.automation.EventAnnounceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
            </intent-filter>
        </receiver>
        <!-- P1 floating charm: tairta orb, tap par chat. Mic se alag service. -->
        <service
            android:name="com.flora.app.automation.FloraCharmService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Flora floating charm" />
        </service>
        <!-- Overlay mic button (v2.22, Phase 1): har screen par mic. -->
        <service
            android:name="com.flora.app.automation.OverlayMicService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Flora overlay mic button" />
        </service>
        <!-- B4 planner foreground service: lamba plan background me
             chale (notification + Auto Log hamesha visible). -->
        <service
            android:name="com.flora.app.planner.PlannerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Flora planner background execution" />
        </service>
        <!-- Call + notification announce (Batch 3): visible foreground
             presence + one-tap stop. Announce receivers/listener se
             hota hai, ye service sirf dikhti hui presence hai. -->
        <service
            android:name="com.flora.app.automation.AnnounceService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Flora call and notification announce" />
        </service>
        <receiver
            android:name="com.flora.app.automation.AnnounceStopReceiver"
            android:exported="false" />
        <!-- Lane A item 37: viewing notification ka Stop action —
             explicit broadcast only, exported=false. -->
        <receiver
            android:name="com.flora.app.viewing.ViewingStopReceiver"
            android:exported="false" />
        <!-- Default assistant (v2.22, Phase 1, G3): invoke par Flora khulti hai. -->
        <service
            android:name="com.flora.app.voice.FloraVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name="com.flora.app.voice.FloraVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>
        <!-- System speech recognizer (v2.23, Phase 5): Flora ki apni
             Deepgram lane se pehchanti hai; system STT lanes chhede nahi. -->
        <service
            android:name="com.flora.app.voice.FloraRecognitionService"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <!-- B2 Builder export (FileProvider): staged ZIP sirf
             cacheDir se, user ke tap par share sheet se jata hai —
             koi silent send/upload nahi. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Live wallpaper (v2.22, Phase 5, G9): sirf drawing. -->
        <service
            android:name="com.flora.app.automation.FloraWallpaperService"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_service" />
        </service>
    </application>
</manifest>
